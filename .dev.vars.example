# Worker environment. Copy to .dev.vars for local development.
# Enable the scheduled evidence checks for this environment.
AGENT_ENABLED=false

# Optional provider. A missing key leaves evidence collection available without AI output.
AI_PROVIDER=
AI_MODEL=
AGENT_API_KEY=
AGENT_SYSTEM_PROMPT=

# Optional admin configuration. All four are required to enable reviewer access.
ADMIN_ORIGIN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
REVIEWER_EMAILS=
