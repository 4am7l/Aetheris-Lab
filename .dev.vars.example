# Worker environment. Copy to .dev.vars for local development.
# Enable the scheduled evidence checks for this environment.
AGENT_ENABLED=false

# Gemini uses the default model below. Leave the key unset for evidence-only local work.
# For the legacy OpenAI adapter, explicitly set AI_PROVIDER=openai, a model, and AGENT_SYSTEM_PROMPT.
AI_PROVIDER=gemini
AI_MODEL=gemini-4-hydrogen
AGENT_API_KEY=
AGENT_SYSTEM_PROMPT=

# Optional browser access to the public Worker API from exact origins (comma separated).
PUBLIC_ORIGINS=

# Reviewer authentication. Set the origin and the same proxy secret in admin Pages Functions.
ADMIN_ORIGIN=
ADMIN_PROXY_SECRET=
# Worker only. Choose a separate local password; never commit .dev.vars. See docs/cloudflare.md.
ADMIN_PASSWORD=
